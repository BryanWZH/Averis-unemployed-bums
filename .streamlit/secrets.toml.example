# Copy to .streamlit/secrets.toml locally, or paste into Streamlit Cloud > Settings > Secrets.
ANTHROPIC_API_KEY = "paste-your-key-here"

# Optional: AI reading spends API credit and the app is public, so it is OFF
# unless this is set AND the visitor types it into the sidebar.
AI_ACCESS_CODE = "choose-a-code-to-share-with-judges"
